# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres connection string (psycopg3 / asyncpg format).
# Example: postgresql+psycopg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Project namespace ─────────────────────────────────────────────────────────
# The Postgres database and the object-storage account are shared with other
# projects. Everything this project creates is kept apart from theirs by one
# namespace: a Postgres schema of that name and a key prefix in the bucket.
# PROJECT_NAMESPACE drives both. Leave DB_SCHEMA and OBJECT_STORAGE_PREFIX
# blank to use the namespace; set them only to override one partition.
# DB_SCHEMA must match ^[a-z][a-z0-9_]*$ and must not be "public".
PROJECT_NAMESPACE=precedent
DB_SCHEMA=
OBJECT_STORAGE_PREFIX=

# ── Object storage (required) ─────────────────────────────────────────────────
# Cloud object storage is required. All four values must be set or the
# application refuses to start. There is no local-filesystem mode, for
# development or otherwise.
# Cloudflare R2: set endpoint to https://<account-id>.r2.cloudflarestorage.com
# Every object is stored under "<OBJECT_STORAGE_PREFIX>/" inside the bucket.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
# sentence-transformers model for pgvector embeddings. Must produce 384-dim vectors.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── LLM cost control ──────────────────────────────────────────────────────────
# Optional: override per-task model tiering and force a single model for all calls.
# Useful during development to avoid Opus charges.
# Example: LLM_TIER_OVERRIDE=claude-haiku-4-5-20251001
LLM_TIER_OVERRIDE=

# ── TEMPORARY DEV-ONLY BYPASS ──────────────────────────────────────────────────
# TEMPORARY DEV-ONLY BYPASS — see backend/.llm_bypass_queue/README.md. Never
# set this in production. This entire mechanism is meant to be deleted — if
# you're reading this and it's still here, ask why.
LLM_FILE_QUEUE_BYPASS=

# ── Runtime ───────────────────────────────────────────────────────────────────
# 'dev' → DEBUG logging; 'prod' → INFO logging.
ENV=dev

# ── Analysis ────────────────────────────────────────────────────────────────────
# Optional: max characters in the Layer 2 content-analysis prompt before clauses
# are split across multiple batched LLM calls instead of one call per contract.
LAYER2_MAX_PROMPT_CHARS=60000

# ── Document processing: Extend ───────────────────────────────────────────────
# Required for document ingest (document_processing_plan.md section 3). Without
# it, uploads fail with a clear, retryable error rather than crashing at import.
EXTEND_API_KEY=
EXTEND_BASE_URL=https://api.extend.ai
EXTEND_EXTRACT_PROCESSOR=extraction_light
EXTEND_EXTRACT_VERSION=3.8.0
EXTEND_PARSE_ENGINE=parse_light
EXTEND_PARSE_VERSION=1.0.0
EXTEND_POLL_INTERVAL_SECONDS=3
EXTEND_TIMEOUT_SECONDS=300
# Our own organisation's name(s), comma-separated, for party role assignment.
# Example: OWN_ORG_NAMES=Halcyon Care,Halcyon Care Ireland Ltd
OWN_ORG_NAMES=
MAX_UPLOAD_MB=25
