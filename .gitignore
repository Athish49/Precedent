# ─── Claude ──────────────────────────────────────────────────────────────────
.claude/
**/.claude/

# ─── Environment / secrets ───────────────────────────────────────────────────
# Any .env file, anywhere in the tree, except an explicit template/example.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.*.example
!**/.env.*.sample

# ─── Python ──────────────────────────────────────────────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.venv/
**/venv/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/*.egg-info/
**/.eggs/
**/.tox/
**/.coverage
**/.coverage.*
**/htmlcov/

# ─── Node / frontend ─────────────────────────────────────────────────────────
**/node_modules/
**/.next/
**/.nuxt/
**/dist/
**/build/
**/out/
**/.vercel/
**/.turbo/
**/.cache/
**/.eslintcache
**/.stylelintcache
**/*.tsbuildinfo
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/
**/playwright/.cache/
**/.pnp
**/.pnp.js
**/.yarn/install-state.gz

# ─── Logs ────────────────────────────────────────────────────────────────────
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# ─── macOS ───────────────────────────────────────────────────────────────────
**/.DS_Store
**/.DS_Store?
**/._*
**/.Spotlight-V100
**/.Trashes

# ─── Windows ─────────────────────────────────────────────────────────────────
**/ehthumbs.db
**/Thumbs.db
**/desktop.ini

# ─── Editor ───────────────────────────────────────────────────────────────────
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
**/.idea/
**/*.swp
**/*.swo
**/*.sw?
**/*~
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln

# ─── Misc build artifacts ────────────────────────────────────────────────────
**/*.tgz
**/*.pem
**/*.key
**/*.p12
**/*.pfx
